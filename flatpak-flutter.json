{
    "app-id": "page.kramo.Sly",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "24.08",
    "sdk": "org.freedesktop.Sdk",
    "sdk-extensions": ["org.freedesktop.Sdk.Extension.llvm19"],
    "command": "sly",
    "separate-locales": false,
    "finish-args": [
        "--device=dri",
        "--share=ipc",
        "--socket=wayland",
        "--socket=fallback-x11"
    ],
    "cleanup-commands": ["rm -r /var/lib/*"],
    "modules": [
        {
            "name": "Sly",
            "buildsystem": "simple",
            "build-options": {
                "build-args": ["--share=network"],
                "arch": {
                    "x86_64": {
                        "env": {
                            "BUNDLE_PATH": "/run/build/Sly/build/linux/x64/release/bundle"
                        }
                    },
                    "aarch64": {
                        "env": {
                            "BUNDLE_PATH": "/run/build/Sly/build/linux/arm64/release/bundle"
                        }
                    }
                },
                "append-path": "/usr/lib/sdk/llvm19/bin:/run/build/Sly/flutter/bin",
                "prepend-ld-library-path": "/usr/lib/sdk/llvm19/lib",
                "env": {
                    "PUB_CACHE": "/run/build/Sly/.pub-cache"
                }
            },
            "build-commands": [
                "flutter build linux --release --no-pub",
                "install -d \"${FLATPAK_DEST}/lib\"",
                "cp -r $BUNDLE_PATH/lib/* \"${FLATPAK_DEST}/lib/\"",
                "install -d \"${FLATPAK_DEST}/data\"",
                "cp -r $BUNDLE_PATH/data/* \"${FLATPAK_DEST}/data/\"",
                "install -d \"${FLATPAK_DEST}/bin\"",
                "install -Dm755 $BUNDLE_PATH/sly \"${FLATPAK_DEST}/sly\"",
                "ln -s \"${FLATPAK_DEST}/sly\" \"${FLATPAK_DEST}/bin/sly\"",
                "install -Dm644 linux/${FLATPAK_ID}.desktop \"${FLATPAK_DEST}/share/applications/${FLATPAK_ID}.desktop\"",
                "install -Dm644 linux/flatpak/${FLATPAK_ID}.metainfo.xml \"${FLATPAK_DEST}/share/metainfo/${FLATPAK_ID}.metainfo.xml\"",
                "install -Dm644 linux/flatpak/${FLATPAK_ID}.svg \"${FLATPAK_DEST}/share/icons/hicolor/scalable/apps/${FLATPAK_ID}.svg\"",
                "install -Dm644 linux/flatpak/${FLATPAK_ID}-symbolic.svg \"${FLATPAK_DEST}/share/icons/hicolor/symbolic/apps/${FLATPAK_ID}-symbolic.svg\""
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/flutter/flutter.git",
                    "tag": "3.44.4",
                    "dest": "flutter"
                },
                {
                    "type": "git",
                    "url": "https://git.kramo.page/Sly.git",
                    "tag": "v1.1.1",
                    "commit": "ac68637fbf3383dd0870410e1d18e363ebb6151c"
                }
            ]
        }
    ]
}
